{
  "name": "qtaro-dev/laravel-recipe-ci-fixture",
  "description": "CI-only Laravel HTTP and database probe; never generated by the application",
  "type": "project",
  "license": "ISC",
  "require": {
    "php": "^8.4",
    "laravel/framework": "12.70.1"
  },
  "autoload": { "psr-4": { "App\\": "app/" } },
  "config": {
    "platform": { "php": "8.4.0" },
    "allow-plugins": false,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
